# Public app URL
NEXT_PUBLIC_APP_URL=

# Temporary V0.1 admin gate. Set these in Vercel Project Settings -> Environment Variables.
AWO_ADMIN_PASSWORD=
AWO_ADMIN_SESSION_TOKEN=
# Set to true only after named Supabase admin login is confirmed.
AWO_DISABLE_TEMP_ADMIN_PASSWORD=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional production exception tracking. Leave blank until Sentry is configured.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
